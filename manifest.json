{
  "manifest_version": 3,
  "name": "YouTube GIF Blocker",
  "version": "1.0.0",
  "description": "Removes animated GIFs, image stickers, and media attachments from YouTube comments and chat.",

  "icons": {
    "16":  "icons/icon-16.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "host_permissions": [
    "*://*.youtube.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
